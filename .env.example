# =============================================================================
# Z.E.N.I.T.H. Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# Blockchain RPC 
# Option A: Polygon zkEVM Cardona (recommended — ZK chain for ZK project)
WEB3_RPC_URL=https://rpc.cardona.zkevm-rpc.com
CHAIN_ID=2442

# Option B: Polygon Amoy (PoS testnet — more faucet support)
# WEB3_RPC_URL=https://rpc-amoy.polygon.technology
# CHAIN_ID=80002

# Option C: Alchemy (more reliable, free tier)
# WEB3_RPC_URL=https://polygonzkevm-cardona.g.alchemy.com/v2/YOUR_API_KEY
# CHAIN_ID=2442

# Smart Contract 
# Address of deployed ZenithEscrow.sol
# Get this after deploying via Remix IDE
ZENITH_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Oracle Wallet 
# Private key of the wallet that submits transactions on-chain (the oracle)
# Get from MetaMask: Account Details → Export Private Key
# NEVER use a mainnet wallet here
ORACLE_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY_HERE

# API Security
# API key for B2B clients to authenticate with the middleware
ZENITH_API_KEY=replace-with-random-secret-key

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Client SDK (client_prover.js)
ZENITH_API_URL=http://localhost:8000
SENDER_WALLET=Wallet_A_Exchange
RECEIVER_WALLET=Wallet_B_Bank
AMOUNT=5000
